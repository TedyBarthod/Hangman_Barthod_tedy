<Window x:Class="Hangman_Barthod_tedy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hangman_Barthod_tedy"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <!-- GRID PRINCIPALE -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <!-- Titre -->
            <RowDefinition Height="*"/>
            <!-- Jeu -->
            <RowDefinition Height="50"/>
            <!-- Essais -->
        </Grid.RowDefinitions>

        <!-- GRID TITRE -->
        <Grid Grid.Row="0" Background="LightBlue">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="HANGMAN" FontSize="28" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Button x:Name="btnNewWord" Grid.Column="1" Content="Nouveau mot" Margin="10"/>
        </Grid>

        <!-- GRID JEU (2 colonnes : pendu + mot | lettres) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- GRID GAUCHE : pendu + mot -->
            <Grid Grid.Column="0" Background="LightGray">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- Pendu -->
                    <RowDefinition Height="80"/>
                    <!-- Mot -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Pendu" FontSize="20"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Border Grid.Row="1" Background="LightYellow" Margin="10">
                    <TextBlock x:Name="txtMot" Text="_ _ _ _ _ _" FontSize="30" FontWeight="Bold"
                               FontFamily="Consolas"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- GRID DROITE : lettres (7 lignes x 4 colonnes) -->
            <Grid Grid.Column="1" Background="LightGreen">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnA" Grid.Row="0" Grid.Column="0" Content="A" Margin="3" FontSize="18"/>
                <Button x:Name="btnB" Grid.Row="0" Grid.Column="1" Content="B" Margin="3" FontSize="18"/>
                <Button x:Name="btnC" Grid.Row="0" Grid.Column="2" Content="C" Margin="3" FontSize="18"/>
                <Button x:Name="btnD" Grid.Row="0" Grid.Column="3" Content="D" Margin="3" FontSize="18"/>

                <Button x:Name="btnE" Grid.Row="1" Grid.Column="0" Content="E" Margin="3" FontSize="18"/>
                <Button x:Name="btnF" Grid.Row="1" Grid.Column="1" Content="F" Margin="3" FontSize="18"/>
                <Button x:Name="btnG" Grid.Row="1" Grid.Column="2" Content="G" Margin="3" FontSize="18"/>
                <Button x:Name="btnH" Grid.Row="1" Grid.Column="3" Content="H" Margin="3" FontSize="18"/>

                <Button x:Name="btnI" Grid.Row="2" Grid.Column="0" Content="I" Margin="3" FontSize="18"/>
                <Button x:Name="btnJ" Grid.Row="2" Grid.Column="1" Content="J" Margin="3" FontSize="18"/>
                <Button x:Name="btnK" Grid.Row="2" Grid.Column="2" Content="K" Margin="3" FontSize="18"/>
                <Button x:Name="btnL" Grid.Row="2" Grid.Column="3" Content="L" Margin="3" FontSize="18"/>

                <Button x:Name="btnM" Grid.Row="3" Grid.Column="0" Content="M" Margin="3" FontSize="18"/>
                <Button x:Name="btnN" Grid.Row="3" Grid.Column="1" Content="N" Margin="3" FontSize="18"/>
                <Button x:Name="btnO" Grid.Row="3" Grid.Column="2" Content="O" Margin="3" FontSize="18"/>
                <Button x:Name="btnP" Grid.Row="3" Grid.Column="3" Content="P" Margin="3" FontSize="18"/>

                <Button x:Name="btnQ" Grid.Row="4" Grid.Column="0" Content="Q" Margin="3" FontSize="18"/>
                <Button x:Name="btnR" Grid.Row="4" Grid.Column="1" Content="R" Margin="3" FontSize="18"/>
                <Button x:Name="btnS" Grid.Row="4" Grid.Column="2" Content="S" Margin="3" FontSize="18"/>
                <Button x:Name="btnT" Grid.Row="4" Grid.Column="3" Content="T" Margin="3" FontSize="18"/>

                <Button x:Name="btnU" Grid.Row="5" Grid.Column="0" Content="U" Margin="3" FontSize="18"/>
                <Button x:Name="btnV" Grid.Row="5" Grid.Column="1" Content="V" Margin="3" FontSize="18"/>
                <Button x:Name="btnW" Grid.Row="5" Grid.Column="2" Content="W" Margin="3" FontSize="18"/>
                <Button x:Name="btnX" Grid.Row="5" Grid.Column="3" Content="X" Margin="3" FontSize="18"/>

                <Button x:Name="btnY" Grid.Row="6" Grid.Column="0" Content="Y" Margin="3" FontSize="18"/>
                <Button x:Name="btnZ" Grid.Row="6" Grid.Column="1" Content="Z" Margin="3" FontSize="18"/>
            </Grid>
        </Grid>

        <!-- GRID ESSAIS -->
        <Grid Grid.Row="2" Background="LightPink">
            <TextBlock x:Name="txtEssais" Text="Essais restants : 6" FontSize="18"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>